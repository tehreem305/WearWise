@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="dashboard-section">
    <div class="container">
        <span class="section-tag">ADMINISTRATION</span>
        <h1 class="dashboard-title">Welcome, Admin!</h1>
        <p class="dashboard-description">
            Manage and monitor the WearWise platform.
        </p>

        <div class="row g-4 mt-4">
            <div class="col-md-4">
                <div class="admin-stat-card">
                    <span class="dashboard-icon">👥</span>
                    <h3>User Management</h3>
                    <p>Manage registered users.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="admin-stat-card">
                    <span class="dashboard-icon">👗</span>
                    <h3>Wardrobe Management</h3>
                    <p>Monitor wardrobe activities.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="admin-stat-card">
                    <span class="dashboard-icon">📊</span>
                    <h3>Platform Overview</h3>
                    <p>View platform information.</p>
                </div>
            </div>
        </div>
    </div>
</section>
