@{
    ViewData["Title"] = "Product Management";
}

<div class="container py-5">
    <h2 class="mb-4">Product Management</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <h5 id="formTitle">Add New Product</h5>
        </div>

        <div class="card-body">
            <form id="productForm">
                <input type="hidden" id="productId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Product Name</label>
                        <input type="text" id="name" class="form-control" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Category</label>
                        <select id="category" class="form-select" required>
                            <option value="">Select Category</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Price</label>
                        <input type="number" id="price" class="form-control"
                               min="0" step="0.01" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Stock</label>
                        <input type="number" id="stock" class="form-control"
                               min="0" required />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">Image URL</label>
                        <input type="text" id="imageUrl" class="form-control" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">Description</label>
                        <textarea id="description" class="form-control"
                                  rows="3"></textarea>
                    </div>
                </div>

                <button type="submit" class="btn btn-dark" id="saveButton">
                    Add Product
                </button>

                <button type="button" class="btn btn-secondary"
                        onclick="resetForm()">
                    Clear
                </button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5>All Products</h5>
        </div>

        <div class="card-body table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="productTable">
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadCategories();
            loadProducts();
        });

        function loadCategories() {
            $.ajax({
                url: '/api/categories',
                type: 'GET',
                success: function (categories) {
                    $('#category').empty();
                    $('#category').append(
                        '<option value="">Select Category</option>'
                    );

                    categories.forEach(function (category) {
                        $('#category').append(
                            `<option value="${category.name}">${category.name}</option>`
                        );
                    });
                },
                error: function () {
                    alert('Unable to load categories.');
                }
            });
        }

        function loadProducts() {
            $.ajax({
                url: '/api/products',
                type: 'GET',
                success: function (products) {
                    $('#productTable').empty();

                    products.forEach(function (product) {
                        $('#productTable').append(`
                            <tr>
                                <td>${product.id}</td>
                                <td>${escapeHtml(product.name)}</td>
                                <td>${escapeHtml(product.category)}</td>
                                <td>${product.price}</td>
                                <td>${product.stock}</td>
                                <td>
                                    <button class="btn btn-sm btn-primary"
                                        onclick="editProduct(${product.id})">
                                        Edit
                                    </button>

                                    <button class="btn btn-sm btn-danger"
                                        onclick="deleteProduct(${product.id})">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        `);
                    });
                },
                error: function () {
                    alert('Unable to load products.');
                }
            });
        }

        $('#productForm').submit(function (e) {
            e.preventDefault();

            const id = $('#productId').val();

            const product = {
                id: id ? parseInt(id) : 0,
                name: $('#name').val(),
                category: $('#category').val(),
                description: $('#description').val(),
                price: parseFloat($('#price').val()),
                imageUrl: $('#imageUrl').val(),
                stock: parseInt($('#stock').val())
            };

            $.ajax({
                url: id ? '/api/products/' + id : '/api/products',
                type: id ? 'PUT' : 'POST',
                contentType: 'application/json',
                data: JSON.stringify(product),

                success: function () {
                    alert(id ? 'Product updated!' : 'Product added!');
                    resetForm();
                    loadProducts();
                },

                error: function (xhr) {
                    alert('Something went wrong: ' + xhr.responseText);
                }
            });
        });

        function editProduct(id) {
            $.ajax({
                url: '/api/products/' + id,
                type: 'GET',

                success: function (product) {
                    $('#productId').val(product.id);
                    $('#name').val(product.name);
                    $('#category').val(product.category);
                    $('#description').val(product.description);
                    $('#price').val(product.price);
                    $('#imageUrl').val(product.imageUrl);
                    $('#stock').val(product.stock);

                    $('#formTitle').text('Edit Product');
                    $('#saveButton').text('Update Product');

                    window.scrollTo({ top: 0, behavior: 'smooth' });
                },

                error: function () {
                    alert('Unable to fetch product.');
                }
            });
        }

        function deleteProduct(id) {
            if (!confirm('Are you sure you want to delete this product?')) {
                return;
            }

            $.ajax({
                url: '/api/products/' + id,
                type: 'DELETE',

                success: function () {
                    alert('Product deleted!');
                    loadProducts();
                },

                error: function () {
                    alert('Unable to delete product.');
                }
            });
        }

        function resetForm() {
            $('#productForm')[0].reset();
            $('#productId').val('');
            $('#formTitle').text('Add New Product');
            $('#saveButton').text('Add Product');
        }

        function escapeHtml(value) {
            return $('<div>').text(value ?? '').html();
        }
    </script>
}
